<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Skyjo.ContinueGame">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1a0a2e" Offset="0"/>
            <GradientStop Color="#2d1050" Offset="0.5"/>
            <GradientStop Color="#1a0a3e" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*" Padding="28,60,28,40">

        <VerticalStackLayout Grid.Row="0" Spacing="6" HorizontalOptions="Center" Margin="0,0,0,32">
            <Label
                Text="REPRENDRE"
                TextColor="#ffffff"
                FontSize="28"
                FontAttributes="Bold"
                CharacterSpacing="4"
                HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="SavesList" Spacing="12">

                <Label
                    x:Name="EmptyLabel"
                    Text="Aucune partie sauvegardée."
                    TextColor="#88c39bd3"
                    FontSize="15"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="False"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
