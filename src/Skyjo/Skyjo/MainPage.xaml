<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Skyjo.MainPage">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1a0a2e" Offset="0"/>
            <GradientStop Color="#2d1050" Offset="0.5"/>
            <GradientStop Color="#1a0a3e" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*,Auto" Padding="28,60,28,40">

        <!-- LOGO -->
        <VerticalStackLayout Grid.Row="0" Spacing="6" HorizontalOptions="Center">
            <Image
                Source="skyjo.png"
                HeightRequest="90"
                HorizontalOptions="Center"
                Aspect="AspectFit"/>

        </VerticalStackLayout>

        <Border
            Grid.Row="1"
            Margin="0,40,0,0"
            VerticalOptions="Center"
            StrokeThickness="1"
            Stroke="#44cc99ff">
            <Border.Background>
                <SolidColorBrush Color="#1acc99ff"/>
            </Border.Background>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28"/>
            </Border.StrokeShape>

            <VerticalStackLayout Padding="28,32" Spacing="14">


                <Border StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#9b59b6" Offset="0"/>
                            <GradientStop Color="#c39bd3" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="50"/>
                    </Border.StrokeShape>
                    <Button
                        Text="Commencer une partie"
                        BackgroundColor="Transparent"
                        TextColor="#ffffff"
                        FontAttributes="Bold"
                        FontSize="15"
                        Padding="0,16"
                        BorderWidth="0"
                        Clicked="OnCreateGameClicked"/>
                </Border>

                <Border
                    StrokeThickness="1.5"
                    Stroke="#9b59b6">
                    <Border.Background>
                        <SolidColorBrush Color="Transparent"/>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="50"/>
                    </Border.StrokeShape>
                    <Button
                        Text="Poursuivre une partie"
                        BackgroundColor="Transparent"
                        TextColor="#c39bd3"
                        FontAttributes="Bold"
                        FontSize="15"
                        Padding="0,16"
                        BorderWidth="0"
                        Clicked="OnContinueGameClicked"/>
                </Border>

            </VerticalStackLayout>
        </Border>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            Margin="0,20,0,0">
            <Button
                Text="Quitter"
                TextColor="#88c39bd3"
                FontSize="14"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center"
               Clicked="CloseAppClicked"/>  <!-- Error -->
            <Button
                Grid.Column="1"
                Text="Règles du jeu"
                TextColor="#88c39bd3"
                FontSize="14"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Clicked="OnRulesClicked"/>
        </Grid>

    </Grid>

</ContentPage>